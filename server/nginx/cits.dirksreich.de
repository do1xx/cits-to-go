# cits.dirksreich.de -> CITS-to-go Doku und Webflasher (statisch aus /var/www/cits).
# cits.1xx.is kommt dazu, sobald der DNS-Eintrag bei Cloudflare existiert.
server {
    server_name cits.dirksreich.de;
    root /var/www/cits;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
    # Lese-API (Statistik, Abdeckung) aus der TimescaleDB, Container mqtt-cits-api
    location /api/ {
        proxy_pass http://127.0.0.1:8095/;
        proxy_set_header Host $host;
    }
    location /firmware/ {
        add_header Cache-Control "no-cache";
        types { application/octet-stream bin; application/json json; }
    }
    location ~* \.png$ {
        expires 1h;
    }
    # Skripte bei jedem Aufruf per ETag prüfen, damit Updates sofort ankommen
    location ~* \.(js|css|html)$ {
        add_header Cache-Control "no-cache";
    }

    listen 80;
    listen [::]:80;
}
