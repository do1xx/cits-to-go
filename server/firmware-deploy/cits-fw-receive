#!/bin/sh
# Forced command for the GitHub Actions deploy key (user citsdeploy).
# Reads a tar archive on stdin with manifest.json and the three firmware parts
# (CITS-to-go-{bootloader,partitions,firmware}-v*.bin), checks it and swaps it into the web root.
set -eu
DEST=/var/www/cits/firmware
TMP=$(mktemp -d /tmp/cits-fw.XXXXXX)
trap 'rm -rf "$TMP"' EXIT
head -c 8000000 | tar -x -C "$TMP" --no-same-owner --no-same-permissions
cd "$TMP"
for f in *; do
  case "$f" in
    manifest.json) ;;
    CITS-to-go-bootloader-v*.bin|CITS-to-go-partitions-v*.bin|CITS-to-go-firmware-v*.bin) ;;
    *) echo "unerwartete Datei: $f" >&2; exit 1 ;;
  esac
done
[ -f manifest.json ] || { echo "manifest.json fehlt" >&2; exit 1; }
check() { # kind min max
  f=$(ls CITS-to-go-$1-v*.bin 2>/dev/null | head -1)
  [ -n "$f" ] || { echo "$1 fehlt" >&2; exit 1; }
  size=$(stat -c %s "$f")
  [ "$size" -ge "$2" ] && [ "$size" -le "$3" ] || { echo "$1: Größe unplausibel ($size)" >&2; exit 1; }
  grep -q "\"path\": \"$f\"" manifest.json || { echo "manifest.json verweist nicht auf $f" >&2; exit 1; }
}
check bootloader 4096 65536
check partitions 1024 4096
check firmware 500000 2097152
for f in CITS-to-go-*.bin; do cp "$f" "$DEST/$f.tmp" && mv "$DEST/$f.tmp" "$DEST/$f"; done
cp manifest.json "$DEST/manifest.json.tmp" && mv "$DEST/manifest.json.tmp" "$DEST/manifest.json"
# keep the current and the previous version of each part
for kind in bootloader partitions firmware; do
  ls -t "$DEST"/CITS-to-go-$kind-v*.bin 2>/dev/null | tail -n +3 | xargs -r rm -f
done
echo "veröffentlicht: $(grep -o '"version": "[^"]*"' manifest.json)"
