# /etc/cits-bridge.env – Konfiguration der festen CITS-to-go-Station
# Node-ID: am besten die MAC des ESP ohne Doppelpunkte (esptool chip-id → BASE MAC)
CITS_NODE_ID=3844be200e94

# Name und Standort der Station (erscheinen auf der Live-Seite)
CITS_NAME=Hamburg Beispielstraße
CITS_LAT=53.5511
CITS_LON=9.9937

# Ziel 1: gemeinsamer Server (eigener Stationszugang)
CITS_MQTT_URL=mqtts://station-3844be200e94:PASSWORT@mqtt.dirksreich.de:8883
# Ziel 2: OpenTrafficMap (ohne Zugangsdaten)
CITS_MQTT_URL_2=mqtts://cits1.opentrafficmap.org:8883

# USB-Gerät des ESP (Linux: /dev/ttyACM*)
CITS_SERIAL=/dev/ttyACM*
